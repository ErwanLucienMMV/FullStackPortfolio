resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

upstream portfolio_api {
    zone portfolio_api 64k;
    server backend:3000 resolve;
}

upstream portfolio_ssr {
    zone portfolio_ssr 64k;
    server ssr:4000 resolve;
}

server {
    listen 8080 ssl;
    listen [::]:8080 ssl;
    server_name ${TLS_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    # HTTP sent to this TLS port produces Nginx status 497.
    error_page 497 =308 https://${TLS_DOMAIN}:${PROXY_PORT}$request_uri;
    include /etc/nginx/portfolio-routes.conf;
}
